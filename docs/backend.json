
{
  "entities": {
    "Agency": {
      "title": "Perfil de Usuário (Multinível)",
      "type": "object",
      "description": "Dados do usuário logado, definindo seu nível de acesso (admin, client, employee).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { 
          "type": "string",
          "enum": ["admin", "client", "employee"],
          "description": "Papel do usuário no sistema: admin (Nextcon), client (Gestor da Empresa), employee (Funcionário)."
        },
        "company": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "ManagedCompany": {
      "title": "Empresa Cliente",
      "type": "object",
      "description": "Empresa atendida pela consultoria Nextcon.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "sector": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "pgrExpiry": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Task": {
      "title": "Plano de Ação",
      "type": "object",
      "description": "Tarefa de segurança ou conformidade do PGR/CIPA.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Colaborador",
      "type": "object",
      "description": "Funcionário de uma empresa cliente gerenciada.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "jobRole": { "type": "string" },
        "admissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "PsychosocialSurvey": {
      "title": "Pesquisa COPSOQ II",
      "type": "object",
      "description": "Avaliação de riscos psicossociais realizada pelo colaborador ou psicólogo.",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "answers": { "type": "object" },
        "totalScore": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/clients/{agencyId}": {
      "schema": "Agency",
      "description": "Perfil central do usuário logado (pode ser admin, cliente ou colaborador)."
    },
    "/clients/{agencyId}/managedCompanies/{companyId}": {
      "schema": "ManagedCompany",
      "description": "Empresas clientes gerenciadas (visível para Admin)."
    },
    "/clients/{agencyId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Plano de ação global do cliente (visível para Admin/Cliente)."
    },
    "/clients/{agencyId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Base global de colaboradores (visível para Admin/Cliente)."
    },
    "/clients/{agencyId}/surveys/{surveyId}": {
      "schema": "PsychosocialSurvey",
      "description": "Resultados das pesquisas (visível para Admin/Cliente)."
    }
  }
}
