
{
  "entities": {
    "SstEvent": {
      "title": "SstEvent",
      "description": "Representa um evento de SST na agenda (exame, visita, treinamento).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "Tipo do evento (Exame Admissional, PGR, etc)" },
        "time": { "type": "string", "description": "Horário formatado (HH:MM)" },
        "date": { "type": "string", "format": "date-time" },
        "companyName": { "type": "string", "description": "Nome da empresa cliente" },
        "location": { "type": "string", "description": "Local ou unidade" },
        "status": { "type": "string", "enum": ["SCHEDULED", "COMPLETED", "CANCELED"] }
      },
      "required": ["id", "type", "date", "companyName"]
    },
    "ProductService": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductService",
      "type": "object",
      "description": "Represents a product or service offered by the company, such as PCMSO or a clinical exam.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ProductService entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the product or service (e.g., PCMSO, Clinical Exam)."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the product or service."
        },
        "serviceGroupId": {
          "type": "string",
          "description": "Reference to ServiceGroup. (Relationship: ServiceGroup 1:N ProductService)"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "serviceGroupId"
      ]
    },
    "ServiceGroup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ServiceGroup",
      "type": "object",
      "description": "Represents a category for grouping services for reporting purposes (e.g., 'Exams', 'Engineering').",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ServiceGroup entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the service group (e.g., Exams, Engineering)."
        },
        "description": {
          "type": "string",
          "description": "Description of the service group."
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "PriceTable": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PriceTable",
      "type": "object",
      "description": "Represents a price table defining prices for clients or standard prices.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the PriceTable entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the price table."
        },
        "clientId": {
          "type": "string",
          "description": "Reference to Client. (Relationship: Client 1:N PriceTable). Nullable, indicates a standard price table if null."
        },
        "isStandard": {
          "type": "boolean",
          "description": "Indicates whether this is a standard price table applicable to all clients."
        }
      },
      "required": [
        "id",
        "name",
        "isStandard"
      ]
    },
    "PriceTableItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PriceTableItem",
      "type": "object",
      "description": "Represents an item within a price table, associating a product/service with a specific price.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the PriceTableItem entity."
        },
        "priceTableId": {
          "type": "string",
          "description": "Reference to PriceTable. (Relationship: PriceTable 1:N PriceTableItem)"
        },
        "productServiceId": {
          "type": "string",
          "description": "Reference to ProductService. (Relationship: ProductService 1:N PriceTableItem)"
        },
        "price": {
          "type": "number",
          "description": "Price of the product/service in this price table."
        }
      },
      "required": [
        "id",
        "priceTableId",
        "productServiceId",
        "price"
      ]
    },
    "ExamCost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
