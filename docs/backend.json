{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuário",
      "type": "object",
      "description": "Dados do usuário no sistema, definindo seu nível de acesso.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { 
          "type": "string",
          "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "EMPLOYEE", "PROVIDER", "SYSTEM_INTEGRATION"],
          "description": "Papel do usuário: SUPER_ADMIN (Nextcon), CLIENT_ADMIN (Gestor Empresa), EMPLOYEE (Funcionário), PROVIDER (Clínica/Médico)."
        },
        "companyId": { "type": "string", "description": "Referência para a empresa do cliente." },
        "linkedEmployeeId": { "type": "string", "description": "Referência para o cadastro de funcionário se for EMPLOYEE." },
        "name": { "type": "string" }
      },
      "required": ["id", "role"]
    },
    "Company": {
      "title": "Empresa Cliente",
      "type": "object",
      "description": "Empresa atendida pela plataforma NEXTCON.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "BLOCKED"] },
        "subscriptionPlan": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "dataEnriched": { "type": "boolean" },
        "city": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Employee": {
      "title": "Colaborador",
      "type": "object",
      "description": "Cadastro de vida vinculada a uma empresa.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "companyId"]
    },
    "Provider": {
      "title": "Prestador de Serviço",
      "type": "object",
      "description": "Entidade que representa uma clínica ou profissional da rede credenciada.",
      "properties": {
        "legacyId": { "type": "string", "description": "Código Original do sistema antigo." },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["PROVIDER", "SYSTEM_INTEGRATION"] },
        "professionalId": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "type": { "type": "string", "enum": ["CRM", "CREA", "MTE", "PR", "CAU", "COREN"] }
          }
        },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "permissions": {
          "type": "object",
          "properties": {
            "canIssueASO": { "type": "boolean" },
            "canManage": { "type": "boolean" },
            "canExam": { "type": "boolean" },
            "canSchedule": { "type": "boolean" }
          }
        }
      },
      "required": ["legacyId", "displayName", "email", "status"]
    },
    "Report": {
      "title": "Relatório Emitido",
      "type": "object",
      "description": "Documento técnico vinculado a uma empresa cliente.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "reportType": { "type": "string" },
        "category": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "reportType", "fileUrl"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Tabela central de permissões de usuários."
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Dados mestre das empresas clientes."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Base global de vidas gerenciadas."
    },
    "/providers/{providerId}": {
      "schema": "Provider",
      "description": "Rede credenciada de clínicas e médicos."
    },
    "/clients/{agencyId}/reports/{reportId}": {
      "schema": "Report",
      "description": "Histórico de arquivos de relatórios por cliente."
    }
  }
}
