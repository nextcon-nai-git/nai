
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. REGRAS DE COLLECTION GROUP (PRIORIDADE MÁXIMA) ---
    // Essencial para Dashboards e Agrupador eSocial que consultam múltiplas unidades ao mesmo tempo.
    match /{path=**}/tasks/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/auditHistory/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/employees/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/examHistory/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/trainings/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/reports/{id} { allow read, list: if request.auth != null; }
    match /{path=**}/sst_events/{id} { allow read, list: if request.auth != null; }

    // --- 2. PERFIS DE USUÁRIO ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- 3. EMPRESAS E UNIDADES (RAIZ) ---
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Em produção, restringir a ADMIN
      
      // Sub-coleções diretas (Fallback caso não seja via Group Query)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    // --- 4. CATÁLOGOS PÚBLICOS ---
    match /catalogs/{document=**} {
      allow read: if true;
    }

    // --- 5. ACESSO GLOBAL (DESENVOLVIMENTO) ---
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
