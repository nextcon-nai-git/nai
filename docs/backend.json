
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string" },
        "servedCompanies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "role", "email"]
    },
    "PgrAiAnalysis": {
      "title": "Análise Neural de PGR",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caminhoStoragePdf": { "type": "string" },
        "estado": { "type": "string" },
        "resultadoIA": { "type": "object" },
        "dataConclusao": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/analisesPGR/{docId}": {
      "schema": "#/backend/entities/PgrAiAnalysis",
      "description": "Pedidos de análise de PGR processados em background pela NAI."
    },
    "/relatorios_sst/{reportId}": {
      "schema": "object",
      "description": "Relatórios de visitas técnicas com análise de IA."
    }
  }
}
