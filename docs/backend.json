
{
  "entities": {
    "Agency": {
      "title": "Perfil de Usuário (Empresa)",
      "type": "object",
      "description": "Dados do usuário/empresa logado no sistema.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "company": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ManagedCompany": {
      "title": "Empresa Cliente",
      "type": "object",
      "description": "Empresa atendida pela empresa consultora.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "sector": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "pgrExpiry": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Task": {
      "title": "Plano de Ação",
      "type": "object",
      "description": "Tarefa de segurança ou conformidade.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Colaborador",
      "type": "object",
      "description": "Funcionário de uma empresa cliente.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "jobRole": { "type": "string" },
        "admissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "PsychosocialSurvey": {
      "title": "Pesquisa COPSOQ II",
      "type": "object",
      "description": "Avaliação de riscos psicossociais.",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "answers": { "type": "object" },
        "totalScore": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/clients/{agencyId}": {
      "schema": "Agency",
      "description": "Perfil da empresa/usuário logado."
    },
    "/clients/{agencyId}/managedCompanies/{companyId}": {
      "schema": "ManagedCompany",
      "description": "Empresas clientes gerenciadas pela empresa principal."
    },
    "/clients/{agencyId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Plano de ação global."
    },
    "/clients/{agencyId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Base global de colaboradores atendidos pela empresa."
    },
    "/clients/{agencyId}/surveys/{surveyId}": {
      "schema": "PsychosocialSurvey",
      "description": "Resultados das pesquisas COPSOQ II."
    }
  }
}
