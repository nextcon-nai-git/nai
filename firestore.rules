
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(agencyId) {
      return isSignedIn() && request.auth.uid == agencyId;
    }

    match /clients/{agencyId} {
      allow get, list, create, update: if isOwner(agencyId);

      match /managedCompanies/{companyId} {
        allow get, list, create, update, delete: if isOwner(agencyId);
      }
      match /employees/{employeeId} {
        allow get, list, create, update, delete: if isOwner(agencyId);
      }
      match /suppliers/{supplierId} {
        allow get, list, create, update, delete: if isOwner(agencyId);
      }
      match /legalExpertises/{expertiseId} {
        allow get, list, create, update, delete: if isOwner(agencyId);
      }
      match /medicalExams/{examId} {
        allow get, list, create, update, delete: if isOwner(agencyId);
      }
    }
  }
}
