rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Regra de Desenvolvimento: Permite qualquer operação para usuários autenticados.
    // O padrão {document=**} cobre documentos individuais.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // 2. Regras de Collection Group (Obrigatórias para Consultas Globais)
    // No Firestore, consultas via collectionGroup exigem o padrão {path=**} 
    // para que as regras encontrem a coleção em qualquer profundidade.
    // Sem isso, o motor de regras nega a listagem global mesmo com a regra acima.
    
    match /{path=**}/tasks/{task} {
      allow read: if request.auth != null;
    }
    match /{path=**}/employees/{employee} {
      allow read: if request.auth != null;
    }
    match /{path=**}/reports/{report} {
      allow read: if request.auth != null;
    }
    match /{path=**}/examHistory/{exam} {
      allow read: if request.auth != null;
    }
    match /{path=**}/auditHistory/{audit} {
      allow read: if request.auth != null;
    }
    match /{path=**}/legalExpertises/{expertise} {
      allow read: if request.auth != null;
    }
    match /{path=**}/sst_events/{event} {
      allow read: if request.auth != null;
    }

    // 3. Catálogos públicos
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}