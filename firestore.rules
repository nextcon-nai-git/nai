rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Funções de Apoio Baseadas em Custom Claims ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Checagem otimizada via token (Custom Claims) injetadas pela Cloud Function
    function isSuperAdmin() { 
      return isSignedIn() && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'ADMIN'); 
    }
    
    function isClientAdmin(companyId) { 
      return isSignedIn() && request.auth.token.role == 'CLIENT_ADMIN' && request.auth.token.companyId == companyId; 
    }
    
    function isDoctor(medicoId) { 
      return isSignedIn() && request.auth.token.role == 'DOCTOR' && request.auth.uid == medicoId; 
    }

    // --- Regras por Coleção ---

    // Empresas
    match /empresas/{empresaId} {
      allow read, write: if isSuperAdmin() || isClientAdmin(empresaId);
    }

    // Colaboradores
    match /colaboradores/{colaboradorId} {
      allow read, delete: if isSuperAdmin() || isClientAdmin(resource.data.empresa_id);
      allow create, update: if isSuperAdmin() || isClientAdmin(request.resource.data.empresa_id);
    }

    // Atendimentos ASO
    match /atendimentos_aso/{atendimentoId} {
      allow read, delete: if isSuperAdmin() || isDoctor(resource.data.medico_id);
      allow create, update: if isSuperAdmin() || isDoctor(request.resource.data.medico_id);
    }

    // Agendamentos
    match /agendamentos/{agendamentoId} {
      allow read: if isSignedIn();
      allow delete: if isSuperAdmin() || isClientAdmin(resource.data.companyId);
      allow create, update: if isSuperAdmin() || isClientAdmin(request.resource.data.companyId);
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      
      // Impede que o usuário mude seu próprio cargo ou empresa (prevenção de hacking)
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId
      );
    }
  }
}