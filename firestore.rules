rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // FUNÇÕES AUXILIARES
    // ----------------------------------------------------------------------
    
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    // Um Super Admin é um membro da equipe NextCon (cargo administrativo) 
    // que NÃO possui vínculo fixo com uma empresa cliente (companyId vazio).
    function isSuperAdmin() {
      let userData = getUserData();
      let role = userData.role;
      return isAuth() && (
        (role == 'SUPER_ADMIN' || role == 'ENGINEER' || role == 'DOCTOR' || role == 'ADMIN') &&
        (!userData.keys().contains('companyId') || userData.companyId == null || userData.companyId == "")
      );
    }

    function isUserInCompany(companyId) {
      let userData = getUserData();
      return isAuth() && (userData.companyId == companyId || isSuperAdmin());
    }

    // ----------------------------------------------------------------------
    // REGRAS DAS COLEÇÕES
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin() || (isAuth() && request.auth.uid == userId);
    }

    match /companies/{companyId} {
      allow read: if isUserInCompany(companyId);
      allow update: if isSuperAdmin() || (isUserInCompany(companyId) && getUserData().role == 'CLIENT_ADMIN');
      allow create, delete: if isSuperAdmin();

      match /{document=**} {
        allow read, write: if isUserInCompany(companyId);
      }
    }

    // ----------------------------------------------------------------------
    // REGRAS PARA COLLECTION GROUPS (Apenas Administradores Globais)
    // ----------------------------------------------------------------------
    
    match /{path=**}/sst_events/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/legalExpertises/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/tasks/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/employees/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/reports/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/contracts/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/examHistory/{id} {
      allow read: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------
    // OUTRAS COLEÇÕES
    // ----------------------------------------------------------------------

    match /catalogs/{catalogId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isAuth();
      allow read, update, delete: if isSuperAdmin();
    }

    match /financialStats/{docId} {
      allow read, write: if isSuperAdmin();
    }
  }
}