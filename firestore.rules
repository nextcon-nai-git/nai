rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global Mestra: Permite que qualquer usuário LOGADO leia, grave e faça 
    // buscas globais (collection-group) em qualquer lugar do banco de dados.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
  }
}