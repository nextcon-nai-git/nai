rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PERMITE TUDO PARA USUÁRIOS LOGADOS (Temporário para Dev)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // SE VOCÊ AINDA NÃO TEM LOGIN, USE ESTA (Cuidado: Libera geral):
    // match /{document=**} {
    //   allow read, write: if true;
    // }
  }
}