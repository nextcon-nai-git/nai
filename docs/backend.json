
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "risk_degree": { "type": "number" },
        "cnae": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "ProfessionalNorm": {
      "title": "ProfessionalNorm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoria": { "type": "string" },
        "orgao": { "type": "string" },
        "norma_principal": { "type": "string" },
        "foco_defesa": { "type": "string" },
        "gatilhos": { "type": "array", "items": { "type": "string" } },
        "texto_legal_padrao": { "type": "string" }
      }
    },
    "Jurisprudence": {
      "title": "Jurisprudence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "aplicacao": { "type": "string" },
        "argumento_automatico": { "type": "string" },
        "anexar_em": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ReverseDenialRule": {
      "title": "ReverseDenialRule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "descricao": { "type": "string" },
        "logica": { "type": "string" }
      }
    },
    "NRNorm": {
      "title": "NRNorm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "norma": { "type": "string" },
        "titulo": { "type": "string" },
        "foco_fiscalizacao": { "type": "string" },
        "acao_preventiva": { "type": "string" }
      }
    },
    "SSTRule": {
      "title": "SSTRule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "evento": { "type": "string" },
        "logica_bloqueio": { "type": "string" },
        "mensagem_erro": { "type": "string" }
      }
    },
    "SSTAsset": {
      "title": "SSTAsset",
      "type": "object",
      "properties": {
        "id_equipamento": { "type": "string" },
        "qr_code_hash": { "type": "string" },
        "categoria": { "type": "string" },
        "tipo": { "type": "string" },
        "ca_numero": { "type": "string" },
        "ca_validade": { "type": "string" },
        "status_uso": { "type": "string" }
      }
    },
    "MedicalAuditRequest": {
      "title": "MedicalAuditRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "professionalCategory": { "type": "string" },
        "diagnosis": { "type": "string" },
        "complexity": { "type": "string", "enum": ["baixa", "media", "alta"] },
        "status": { "type": "string" },
        "defenseStrategy": {
          "type": "object",
          "properties": {
            "norma_base": { "type": "string" },
            "texto_argumentacao": { "type": "string" },
            "alerta_sistema": { "type": "string" }
          }
        },
        "expertiseChecklist": {
          "type": "object",
          "properties": {
            "anamnese": { "type": "string" },
            "exameFisico": { "type": "string" },
            "nexoCausal": { "type": "string", "enum": ["confirmado", "excluido", "concausa"] },
            "observacoes": { "type": "string" },
            "filledAt": { "type": "string", "format": "date-time" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "companyId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/entities/Company",
      "description": "Empresas clientes (Raiz)."
    },
    "/config_normas_profissionais/{normId}": {
      "schema": "#/entities/ProfessionalNorm",
      "description": "Base de inteligência dos conselhos profissionais."
    },
    "/config_jurisprudencia/{jurId}": {
      "schema": "#/entities/Jurisprudence",
      "description": "Repositório de teses jurídicas e decisões STJ/ANS."
    },
    "/config_glosa_reversa/{ruleId}": {
      "schema": "#/entities/ReverseDenialRule",
      "description": "Regras automáticas para validação de contas hospitalares."
    },
    "/config_nrs/{nrId}": {
      "schema": "#/entities/NRNorm",
      "description": "Base de Normas Regulamentadoras SST."
    },
    "/config_regras_sst/{ruleId}": {
      "schema": "#/entities/SSTRule",
      "description": "Regras de conformidade e travas eSocial."
    },
    "/ativos_sst_equipamentos/{assetId}": {
      "schema": "#/entities/SSTAsset",
      "description": "Inventário de equipamentos e EPIs com QR Code."
    },
    "/medical_audit_requests/{requestId}": {
      "schema": "#/entities/MedicalAuditRequest",
      "description": "Solicitações de auditoria médica e defesa inteligente."
    }
  }
}
