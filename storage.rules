rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Funções de Apoio (Autenticação e Dados do Usuário)
    function isSignedIn() { 
      return request.auth != null; 
    }
    function getUserData() { 
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; 
    }
    
    // Funções de Papéis (RBAC)
    function isAdmin() { 
      let role = getUserData().role;
      return isSignedIn() && (role == 'SUPER_ADMIN' || role == 'ADMIN'); 
    }
    
    function isOwner(clientId) { 
      let user = getUserData();
      return isSignedIn() && user.role == 'CLIENT_ADMIN' && user.companyId == clientId; 
    }
    
    // Atualizado para englobar a equipe multidisciplinar de saúde e segurança
    function isHealthProfessional() {
      let role = getUserData().role;
      // Se você atualizar seu banco para uma role única, use: return role == 'HEALTH_PROFESSIONAL';
      // Como o seu banco atual tem várias roles, verificamos se a role está na lista de profissionais:
      return isSignedIn() && (role in ['DOCTOR', 'PROVIDER', 'ENGINEER', 'HEALTH_PROFESSIONAL']);
    }

    // Funções de Segurança de Arquivo (Prevenção de Abuso)
    function isSafeFile() {
      // Limita a 5MB (5 * 1024 * 1024 bytes) e permite apenas PDF, JPEG e PNG
      return request.resource.size < 5 * 1024 * 1024 
          && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // 1. ÁREA PÚBLICA: Leitura livre, Escrita apenas Admins
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeFile();
    }

    // 2. INTERNOS NEXTCON: Acesso exclusivo equipe interna
    match /internos_nextcon/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isSafeFile();
    }

    // 3. ÁREA DE CLIENTES: Isolamento Lógico (Multi-tenant)
    match /clientes/{clientId}/{allPaths=**} {
      // Admins acessam tudo.
      // O cliente acessa apenas a SUA pasta.
      // O Profissional da Saúde/SST pode ler e gravar (para subir ASOs, PGR, PCMSO, laudos, etc).
      allow read: if isAdmin() || isOwner(clientId) || isHealthProfessional();
      allow write: if (isAdmin() || isOwner(clientId) || isHealthProfessional()) && isSafeFile();
    }

    // Fallback de Segurança (Bloqueia tudo que não cair nas regras acima)
    match /{allPaths=**} {
      allow read, write: if false; 
    }
  }
}