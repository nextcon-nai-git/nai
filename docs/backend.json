
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "risk_degree": { "type": "number" },
        "cnae": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "WorkAllocation": {
      "title": "WorkAllocation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "riskLevel": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "blocked"] },
        "blockingReasons": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "EsocialEvent": {
      "title": "EsocialEvent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "employeeName": { "type": "string" },
        "status": { "type": "string" },
        "firewallMessage": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "ProfessionalNorm": {
      "title": "ProfessionalNorm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoria": { "type": "string" },
        "orgao": { "type": "string" },
        "norma_principal": { "type": "string" },
        "foco_defesa": { "type": "string" },
        "gatilhos": { "type": "array", "items": { "type": "string" } },
        "texto_legal_padrao": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/entities/Company",
      "description": "Empresas clientes (Raiz)."
    },
    "/companies/{companyId}/work_allocations/{id}": {
      "schema": "#/entities/WorkAllocation",
      "description": "Registros de alocação monitorados pelo Vigia de Compliance."
    },
    "/companies/{companyId}/esocial_events_queue/{id}": {
      "schema": "#/entities/EsocialEvent",
      "description": "Fila de eventos monitorada pelo Firewall eSocial."
    }
  }
}
