rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PERMITE TUDO PARA USUÁRIOS LOGADOS (Modo Desenvolvimento / Multi-tenancy validado via app logic)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regra para metadados públicos se necessário
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}