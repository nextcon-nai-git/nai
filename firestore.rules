rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global 1: Exige que o usuário esteja logado no sistema
    function isAutenticado() {
      return request.auth != null;
    }

    // Suporte para Collection Groups (Consultas Globais)
    // Permite que componentes como o Quadro de Vidas e o Kanban listem dados de todas as unidades
    match /{path=**}/employees/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/tasks/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/legalExpertises/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/reports/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/sst_events/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/examHistory/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/access_logs/{docId} { allow read: if isAutenticado(); }
    match /{path=**}/esocial_events_queue/{docId} { allow read: if isAutenticado(); }

    // Regras para as coleções raiz da plataforma
    match /companies/{companyId} {
      allow read, write: if isAutenticado();
      
      // Permite acesso a todas as sub-coleções das empresas (Contratos, Funcionários, etc)
      match /{allChildren=**} {
        allow read, write: if isAutenticado();
      }
    }
    
    match /users/{userId} {
      allow read, write: if isAutenticado();
    }
    
    match /medical_audit_requests/{docId} {
      allow read, write: if isAutenticado();
    }

    match /orcamentos/{docId} {
      allow read, write: if isAutenticado();
    }

    // Regra de segurança "Pega-tudo" para testes internos
    // AVISO: Libera leitura/escrita para qualquer pessoa logada. Ideal para desenvolvimento.
    match /{document=**} {
      allow read, write: if isAutenticado();
    }
  }
}