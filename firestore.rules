rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Regra de Acesso Direto: Permite qualquer operação para usuários autenticados.
    // Isso cobre documentos específicos e sub-coleções quando acessados via caminho completo.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // 2. Regras de Collection Group (Obrigatórias para Dashboards Globais)
    // No Firestore, consultas que abrangem múltiplas sub-coleções em toda a base (collectionGroup)
    // exigem o padrão {path=**}/collectionId/{doc} para serem autorizadas.
    
    match /{path=**}/tasks/{task} {
      allow read: if request.auth != null;
    }
    match /{path=**}/employees/{employee} {
      allow read: if request.auth != null;
    }
    match /{path=**}/reports/{report} {
      allow read: if request.auth != null;
    }
    match /{path=**}/examHistory/{exam} {
      allow read: if request.auth != null;
    }
    match /{path=**}/auditHistory/{audit} {
      allow read: if request.auth != null;
    }
    match /{path=**}/legalExpertises/{expertise} {
      allow read: if request.auth != null;
    }
    match /{path=**}/sst_events/{event} {
      allow read: if request.auth != null;
    }

    // 3. Catálogos públicos
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}