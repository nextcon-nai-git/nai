
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" },
        "servedCompanies": { "type": "array", "items": { "type": "string" }, "description": "Lista de IDs de empresas atendidas (raio 50km)" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "risk_degree": { "type": "number" },
        "cnae": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "OccupationalExamAppointment": {
      "title": "OccupationalExamAppointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeePhone": { "type": "string" },
        "clinicId": { "type": "string" },
        "clinicName": { "type": "string" },
        "examType": { "type": "string", "enum": ["Admissional", "Periódico", "Demissional", "Mudança de Função", "Retorno ao Trabalho"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["disponivel", "agendado", "concluido", "cancelado"] },
        "companyId": { "type": "string" }
      },
      "required": ["clinicId", "examType", "scheduledAt", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/entities/Company",
      "description": "Empresas clientes (Raiz)."
    },
    "/exam_appointments/{id}": {
      "schema": "#/entities/OccupationalExamAppointment",
      "description": "Agendamentos de exames ocupacionais com clínicas parceiras."
    }
  }
}
