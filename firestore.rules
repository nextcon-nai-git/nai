rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Regra Global: Permite qualquer operação para usuários autenticados (Modo Dev/Ops)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // 2. Regras de Collection Group (Obrigatórias para Dashboards Globais e Consultas Multi-tenant)
    // No Firestore, consultas via collectionGroup exigem o padrão {path=**} 
    // e permissões explícitas de 'list' para autorizar a listagem em qualquer profundidade.
    
    match /{path=**}/tasks/{task} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/employees/{employee} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/reports/{report} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/examHistory/{exam} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/auditHistory/{audit} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/legalExpertises/{expertise} {
      allow read, list, write: if request.auth != null;
    }
    match /{path=**}/sst_events/{event} {
      allow read, list, write: if request.auth != null;
    }

    // 3. Catálogos e Tabelas de Referência
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}