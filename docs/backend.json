
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" },
        "servedCompanies": { "type": "array", "items": { "type": "string" }, "description": "Lista de IDs de empresas atendidas (raio 50km)" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "MedicalCompany": {
      "title": "Empresa (Medicina)",
      "type": "object",
      "properties": {
        "empresa_id": { "type": "string" },
        "razao_social": { "type": "string" },
        "cnpj": { "type": "string" },
        "contato_rh": {
          "type": "object",
          "properties": {
            "nome": { "type": "string" },
            "email": { "type": "string" },
            "telefone": { "type": "string" }
          }
        },
        "setores": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["razao_social", "cnpj"]
    },
    "MedicalEmployee": {
      "title": "Colaborador",
      "type": "object",
      "properties": {
        "colaborador_id": { "type": "string" },
        "empresa_id": { "type": "string" },
        "nome": { "type": "string" },
        "cpf": { "type": "string" },
        "funcao": { "type": "string" },
        "riscos": { "type": "array", "items": { "type": "string" }, "description": "Essencial para S-2240" }
      },
      "required": ["empresa_id", "nome", "cpf"]
    },
    "Appointment": {
      "title": "Agendamento",
      "type": "object",
      "properties": {
        "agendamento_id": { "type": "string" },
        "colaborador_id": { "type": "string" },
        "data_hora": { "type": "string", "format": "date-time" },
        "tipo": { "type": "string", "enum": ["Admissional", "Periódico", "Demissional", "Mudança de Função", "Retorno ao Trabalho"] },
        "status": { "type": "string", "enum": ["Agendado", "Em Espera", "Em Atendimento", "Concluído"] },
        "check_in_realizado": { "type": "boolean" }
      },
      "required": ["colaborador_id", "data_hora", "tipo", "status"]
    },
    "AsoAttendance": {
      "title": "Atendimento ASO",
      "type": "object",
      "properties": {
        "atendimento_id": { "type": "string" },
        "agendamento_id": { "type": "string" },
        "medico_id": { "type": "string" },
        "data_emissao": { "type": "string", "format": "date-time" },
        "resultado": { "type": "string", "enum": ["Apto", "Inapto"] },
        "url_documento_assinado": { "type": "string" },
        "status_esocial": { "type": "string", "enum": ["Pendente", "Enviado", "Erro"] },
        "protocolo_governo": { "type": "string" }
      },
      "required": ["agendamento_id", "medico_id", "resultado"]
    },
    "PartnerClinic": {
      "title": "Clínica Parceira",
      "type": "object",
      "properties": {
        "clinica_id": { "type": "string" },
        "nome_fantasia": { "type": "string" },
        "localizacao": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "servicos_disponiveis": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/empresas/{empresaId}": {
      "schema": "#/entities/MedicalCompany",
      "description": "Empresas clientes do módulo médico."
    },
    "/colaboradores/{colaboradorId}": {
      "schema": "#/entities/MedicalEmployee",
      "description": "Base de colaboradores para vigilância em saúde."
    },
    "/agendamentos/{agendamentoId}": {
      "schema": "#/entities/Appointment",
      "description": "Fila de exames ocupacionais."
    },
    "/atendimentos_aso/{atendimentoId}": {
      "schema": "#/entities/AsoAttendance",
      "description": "Registros de ASOs e integração eSocial."
    },
    "/clinicas_parceiras/{clinicaId}": {
      "schema": "#/entities/PartnerClinic",
      "description": "Rede credenciada Nextcon."
    }
  }
}
