rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio para RBAC
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return isSignedIn() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'ADMIN'); }
    function isClientAdmin(companyId) { return isSignedIn() && getUserData().role == 'CLIENT_ADMIN' && getUserData().companyId == companyId; }
    function isDoctor(medicoId) { return isSignedIn() && getUserData().role == 'DOCTOR' && request.auth.uid == medicoId; }

    // Bloqueio Total por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Regra Global para Super Admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Empresas: CLIENT_ADMIN restrito à sua própria empresa
    match /empresas/{empresaId} {
      allow read, write: if isSuperAdmin() || isClientAdmin(empresaId);
    }

    // Colaboradores: Restrito via ID da empresa no documento
    match /colaboradores/{colaboradorId} {
      allow read, write: if isSuperAdmin() || isClientAdmin(resource.data.empresa_id || request.resource.data.empresa_id);
    }

    // Atendimentos ASO: Privacidade Médica (Apenas o médico ou Super Admin)
    match /atendimentos_aso/{atendimentoId} {
      allow read, write: if isSuperAdmin() || isDoctor(resource.data.medico_id || request.resource.data.medico_id);
    }

    // Agendamentos: Visibilidade para recepção/médicos, escrita para Admins
    match /agendamentos/{agendamentoId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isClientAdmin(request.resource.data.companyId);
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }
  }
}