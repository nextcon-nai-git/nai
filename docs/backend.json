
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "risk_degree": { "type": "number" },
        "cnae": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "WorkAllocation": {
      "title": "WorkAllocation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "riskLevel": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "blocked"] },
        "blockingReasons": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AccessLog": {
      "title": "AccessLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "area": { "type": "string" },
        "status": { "type": "string", "enum": ["authorized", "denied"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "EsocialEvent": {
      "title": "EsocialEvent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "employeeName": { "type": "string" },
        "status": { "type": "string" },
        "firewallMessage": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "MedicalAuditRequest": {
      "title": "MedicalAuditRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "professionalCategory": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string" },
        "defenseStrategy": { "type": "object" },
        "expertiseChecklist": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "NaiSalesPitch": {
      "title": "NaiSalesPitch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ativo": { "type": "boolean" },
        "avatar": { "type": "object" },
        "pilares_venda": { "type": "array" },
        "cta_final": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/entities/Company",
      "description": "Empresas clientes (Raiz)."
    },
    "/companies/{companyId}/work_allocations/{id}": {
      "schema": "#/entities/WorkAllocation",
      "description": "Registros de alocação monitorados pelo Vigia de Compliance."
    },
    "/companies/{companyId}/access_logs/{id}": {
      "schema": "#/entities/AccessLog",
      "description": "Logs de acesso físico por crachá RFID em áreas de risco."
    },
    "/companies/{companyId}/esocial_events_queue/{id}": {
      "schema": "#/entities/EsocialEvent",
      "description": "Fila de eventos monitorada pelo Firewall eSocial."
    },
    "/medical_audit_requests/{id}": {
      "schema": "#/entities/MedicalAuditRequest",
      "description": "Solicitações de auditoria médica e super-junta."
    },
    "/config_nai_avatar/{id}": {
      "schema": "#/entities/NaiSalesPitch",
      "description": "Configurações de roteiro e avatar da assistente virtual."
    }
  }
}
