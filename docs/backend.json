
{
  "entities": {
    "SstEvent": {
      "title": "SstEvent",
      "description": "Representa um evento de SST na agenda (exame, visita, treinamento).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "Tipo do evento (Exame Admissional, PGR, etc)" },
        "time": { "type": "string", "description": "Horário formatado (HH:MM)" },
        "date": { "type": "string", "format": "date-time" },
        "companyName": { "type": "string", "description": "Nome da empresa cliente" },
        "location": { "type": "string", "description": "Local ou unidade" },
        "status": { "type": "string", "enum": ["SCHEDULED", "COMPLETED", "CANCELED"] }
      },
      "required": ["id", "type", "date", "companyName"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Represents a client company with its specific industry segment.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { 
          "type": "string", 
          "enum": ["CONSTRUCTION", "HOSPITAL", "INDUSTRY", "GENERAL"],
          "description": "Determina o foco normativo do sistema."
        },
        "city": { "type": "string" }
      },
      "required": ["id", "name", "cnpj", "segment"]
    },
    "ProductService": {
      "title": "ProductService",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "serviceGroupId": { "type": "string" }
      },
      "required": ["id", "name", "description", "serviceGroupId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" },
              "email": { "type": "string" },
              "companyId": { "type": "string" }
            }
          },
          "description": "Perfil do usuário."
        }
      },
      {
        "path": "/clients/{clientId}/managedCompanies/{companyId}",
        "definition": {
          "entityName": "Client",
          "schema": { "$ref": "#/backend/entities/Client" },
          "description": "Empresas gerencias pela agência."
        }
      },
      {
        "path": "/clients/{clientId}/sst_events/{eventId}",
        "definition": {
          "entityName": "SstEvent",
          "schema": { "$ref": "#/backend/entities/SstEvent" },
          "description": "Eventos de agenda."
        }
      }
    ]
  }
}
