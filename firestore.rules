rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra global: permite tudo para usuários autenticados em modo de desenvolvimento
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regras explícitas para Collection Groups (OBRIGATÓRIO para Dashboards Globais)
    // O Firestore exige matches específicos para autorizar consultas via collectionGroup
    
    match /{path=**}/tasks/{task} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/employees/{employee} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/reports/{report} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/examHistory/{exam} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/auditHistory/{audit} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/legalExpertises/{expertise} {
      allow read: if request.auth != null;
    }
    
    match /{path=**}/sst_events/{event} {
      allow read: if request.auth != null;
    }

    // Regra para catálogos públicos
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}