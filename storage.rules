rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Funções de Apoio
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'ADMIN'); }
    function isOwner(clientId) { return isSignedIn() && getUserData().companyId == clientId; }
    
    // Verifica se o médico atende esta empresa
    function isAuthorizedDoctor(clientId) { 
      let data = getUserData();
      return isSignedIn() && data.role == 'DOCTOR' && (clientId in data.servedCompanies); 
    }

    // Validação de Segurança do Arquivo (Tipo e Tamanho)
    function isValidFile() {
      return request.resource.size < 10 * 1024 * 1024 // Limite de 10MB
        && (request.resource.contentType.matches('application/pdf') 
            || request.resource.contentType.matches('image/.*'));
    }

    // ÁREA DE CLIENTES: Isolamento Lógico (Multi-tenant)
    match /clientes/{clientId}/{allPaths=**} {
      allow read: if isAdmin() || isOwner(clientId) || isAuthorizedDoctor(clientId);
      
      // Bloqueia arquivos maliciosos ou excessivamente grandes
      allow write: if (isAdmin() || isOwner(clientId) || isAuthorizedDoctor(clientId)) && isValidFile();
    }

    // ÁREA PÚBLICA
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback de Segurança
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}