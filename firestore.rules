rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global de Desenvolvimento: permite leitura/escrita para qualquer usuário autenticado.
    // Isso garante que consultas do tipo collectionGroup (Dashboards) funcionem sem bloqueios complexos.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regras explícitas para Collection Groups.
    // O Firestore exige matches específicos para autorizar consultas globais via collectionGroup.
    match /{path=**}/tasks/{task} {
      allow read: if request.auth != null;
    }
    match /{path=**}/employees/{employee} {
      allow read: if request.auth != null;
    }
    match /{path=**}/reports/{report} {
      allow read: if request.auth != null;
    }
    match /{path=**}/examHistory/{exam} {
      allow read: if request.auth != null;
    }
    match /{path=**}/auditHistory/{audit} {
      allow read: if request.auth != null;
    }
    match /{path=**}/legalExpertises/{expertise} {
      allow read: if request.auth != null;
    }
    match /{path=**}/sst_events/{event} {
      allow read: if request.auth != null;
    }

    // Catálogos públicos (Riscos eSocial, etc)
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}