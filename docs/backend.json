
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Employee": {
      "title": "Employee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "job_role": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "cbo": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["active", "leave", "fired"] }
      }
    },
    "Task": {
      "title": "OpsTask",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "priority": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "description": "Perfis de acesso e permissões RBAC."
        }
      },
      {
        "path": "/companies/{companyId}",
        "definition": {
          "entityName": "Company",
          "description": "Empresas clientes (Contratos Master ou Unidades)."
        }
      },
      {
        "path": "/companies/{companyId}/employees/{employeeId}",
        "definition": {
          "entityName": "Employee",
          "description": "Funcionários vinculados à empresa."
        }
      },
      {
        "path": "/companies/{companyId}/tasks/{taskId}",
        "definition": {
          "entityName": "Task",
          "description": "Cards de operação (PGR, PCMSO, eSocial) específicos da empresa."
        }
      },
      {
        "path": "/companies/{companyId}/documents/{docId}",
        "definition": {
          "entityName": "Document",
          "description": "Metadados de laudos e arquivos técnicos."
        }
      },
      {
        "path": "/catalogs/{catalogId}",
        "definition": {
          "schema": { "type": "object" },
          "description": "Dados compartilhados (Riscos eSocial, Tabela de Exames)."
        }
      }
    ]
  }
}
