rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // FUNÇÕES AUXILIARES
    // ----------------------------------------------------------------------
    
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuth() && getUserData().role == 'SUPER_ADMIN';
    }

    function isUserInCompany(companyId) {
      return isAuth() && getUserData().companyId == companyId;
    }

    // ----------------------------------------------------------------------
    // REGRAS DAS COLEÇÕES
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow read: if isUserInCompany(companyId) || isSuperAdmin();
      allow update: if isSuperAdmin() || (isUserInCompany(companyId) && getUserData().role == 'CLIENT_ADMIN');
      allow create, delete: if isSuperAdmin();

      match /{document=**} {
        allow read, write: if isUserInCompany(companyId) || isSuperAdmin();
      }
    }

    // ----------------------------------------------------------------------
    // REGRAS PARA COLLECTION GROUPS (Consultas Globais do Admin)
    // ----------------------------------------------------------------------
    
    match /{path=**}/sst_events/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/legalExpertises/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/tasks/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/employees/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/reports/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/contracts/{id} {
      allow read: if isSuperAdmin();
    }
    match /{path=**}/examHistory/{id} {
      allow read: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------
    // OUTRAS COLEÇÕES
    // ----------------------------------------------------------------------

    match /catalogs/{catalogId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isAuth();
      allow read, update, delete: if isSuperAdmin();
    }

    match /financialStats/{docId} {
      allow read, write: if isSuperAdmin();
    }
  }
}