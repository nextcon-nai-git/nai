rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio para RBAC
    function isAutenticado() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isAutenticado() && (data.role == 'SUPER_ADMIN' || data.role == 'ADMIN');
    }

    function isClientAdmin(companyId) {
      let data = getUserData();
      return isAutenticado() && data.role == 'CLIENT_ADMIN' && data.companyId == companyId;
    }

    function isDoctor(medicoId) {
      return isAutenticado() && (getUserData().role == 'DOCTOR' && request.auth.uid == medicoId) || isAdmin();
    }

    // Bloqueio Total para não autenticados
    match /{document=**} {
      allow read, write: if false;
    }

    // Regras de Perfis de Usuário
    match /users/{userId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Coleção de Empresas (Medicina)
    match /empresas/{empresaId} {
      allow read, write: if isAdmin() || isClientAdmin(empresaId);
    }

    // Coleção de Colaboradores
    match /colaboradores/{colaboradorId} {
      allow read, write: if isAdmin() || isClientAdmin(resource.data.empresa_id || request.resource.data.empresa_id);
    }

    // Coleção de Agendamentos (Fila Real-time)
    match /agendamentos/{agendamentoId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || isClientAdmin(request.resource.data.companyId);
    }

    // Atendimentos ASO (Privacidade Médica)
    match /atendimentos_aso/{atendimentoId} {
      allow read: if isAdmin() || isDoctor(resource.data.medico_id) || isClientAdmin(resource.data.companyId);
      allow write: if isAdmin() || isDoctor(request.resource.data.medico_id);
    }

    // Fallback Administrativo (Apenas Super Admins)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}