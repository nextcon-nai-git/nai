rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio para RBAC e Geofencing
    function isAutenticado() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isAutenticado() && (data.role == 'SUPER_ADMIN' || data.role == 'ADMIN');
    }

    function isClientAdmin(companyId) {
      let data = getUserData();
      return isAutenticado() && data.role == 'CLIENT_ADMIN' && data.companyId == companyId;
    }

    /**
     * Valida se o prestador atende aquela empresa específica.
     */
    function isServedProvider(companyId) {
      let data = getUserData();
      let role = data.role;
      return isAutenticado() && 
             (role == 'PROVIDER' || role == 'ENGINEER' || role == 'DOCTOR') && 
             (data.servedCompanies != null && companyId in data.servedCompanies);
    }

    // Regras para a Coleção de Empresas (Clientes)
    match /companies/{companyId} {
      allow read: if isAdmin() || isClientAdmin(companyId) || isServedProvider(companyId);
      allow write: if isAdmin();

      // Sub-coleção de Colaboradores (Hierárquica)
      match /employees/{employeeId} {
        allow read: if isAdmin() || isClientAdmin(companyId) || isServedProvider(companyId);
        allow write: if isAdmin() || isClientAdmin(companyId);
      }

      // Outras sub-coleções (Tarefas, Relatórios, etc)
      match /{allChildren=**} {
        allow read, write: if isAdmin() || isClientAdmin(companyId) || isServedProvider(companyId);
      }
    }
    
    // Suporte para Consultas Globais (Collection Groups)
    // Permite que o Admin veja todos os colaboradores do sistema de uma vez
    match /{path=**}/employees/{docId} { 
      allow read: if isAdmin() || isServedProvider(resource.data.companyId); 
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Fallback Administrativo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}