rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Funções de Apoio (Autenticação e Dados do Usuário)
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Busca dados no Firestore para RBAC (Caso Custom Claims ainda não tenham propagado)
    function getUserData() { 
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'ADMIN'); 
    }
    
    function isOwner(clientId) { 
      return isSignedIn() && request.auth.token.role == 'CLIENT_ADMIN' && request.auth.token.companyId == clientId; 
    }
    
    function isHealthProfessional() {
      return isSignedIn() && (request.auth.token.role in ['DOCTOR', 'PROVIDER', 'ENGINEER']);
    }

    // Funções de Segurança de Arquivo (Firewall)
    function isSafeFile() {
      // Limita a 5MB e permite apenas PDF e Imagens (PNG/JPG)
      return request.resource.size < 5 * 1024 * 1024 
          && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // 1. ÁREA PÚBLICA: Escrita apenas Admins
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeFile();
    }

    // 2. INTERNOS NEXTCON: Acesso exclusivo equipe interna
    match /internos_nextcon/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isSafeFile();
    }

    // 3. ÁREA DE CLIENTES: Isolamento Multi-tenant
    match /clientes/{clientId}/{allPaths=**} {
      // Admins e Profissionais de Saúde acessam. O cliente acessa apenas a SUA pasta.
      allow read: if isAdmin() || isOwner(clientId) || isHealthProfessional();
      allow write: if (isAdmin() || isOwner(clientId) || isHealthProfessional()) && isSafeFile();
    }

    // Fallback de Segurança
    match /{allPaths=**} {
      allow read, write: if false; 
    }
  }
}