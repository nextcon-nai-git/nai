rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio para RBAC e Geofencing
    function isAutenticado() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isAutenticado() && (data.role == 'SUPER_ADMIN' || data.role == 'ADMIN');
    }

    function isClientAdmin(companyId) {
      let data = getUserData();
      return isAutenticado() && data.role == 'CLIENT_ADMIN' && data.companyId == companyId;
    }

    /**
     * Valida se o prestador atende aquela empresa específica.
     * O vínculo é gerado automaticamente via raio de 50km no Setup.
     */
    function isServedProvider(companyId) {
      let data = getUserData();
      let role = data.role;
      return isAutenticado() && 
             (role == 'PROVIDER' || role == 'ENGINEER' || role == 'DOCTOR') && 
             (data.servedCompanies != null && companyId in data.servedCompanies);
    }

    // Regras para a Coleção de Empresas (Clientes)
    match /companies/{companyId} {
      allow read: if isAdmin() || isClientAdmin(companyId) || isServedProvider(companyId);
      allow write: if isAdmin();

      // Permite acesso a sub-coleções baseado no Geofencing ( servedCompanies )
      match /{allChildren=**} {
        allow read, write: if isAdmin() || isClientAdmin(companyId) || isServedProvider(companyId);
      }
    }
    
    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Auditoria Médica e Regulação
    match /medical_audit_requests/{docId} {
      allow read, write: if isAdmin() || getUserData().role == 'DOCTOR' || getUserData().role == 'PROVIDER';
    }

    // Suporte para Consultas Globais (Collection Groups) protegidas por Geofencing
    match /{path=**}/employees/{docId} { allow read: if isAdmin() || isServedProvider(resource.data.companyId); }
    match /{path=**}/tasks/{docId} { allow read: if isAdmin() || isServedProvider(resource.data.companyId); }
    match /{path=**}/legalExpertises/{docId} { allow read: if isAdmin() || isServedProvider(resource.data.companyId); }
    match /{path=**}/reports/{docId} { allow read: if isAdmin() || isServedProvider(resource.data.companyId); }

    // Fallback Administrativo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
