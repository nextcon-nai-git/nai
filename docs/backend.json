
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string" },
        "servedCompanies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Empresa Cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "risk_degree": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "cnpj"]
    },
    "OpsTask": {
      "title": "Tarefa Operacional / Comercial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "companyId": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" }
      }
    },
    "MedicalAppointment": {
      "title": "Agendamento Médico",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "colaborador_nome": { "type": "string" },
        "status": { "type": "string" },
        "tipo": { "type": "string" },
        "companyId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/backend/entities/Company",
      "description": "Base de empresas clientes."
    },
    "/companies/{companyId}/tasks/{taskId}": {
      "schema": "#/backend/entities/OpsTask",
      "description": "Fila de tarefas e propostas comerciais."
    },
    "/companies/{companyId}/employees/{employeeId}": {
      "schema": "object",
      "description": "Vidas sob vigilância de cada unidade."
    },
    "/agendamentos/{id}": {
      "schema": "#/backend/entities/MedicalAppointment",
      "description": "Fila de exames admissionais e periódicos."
    },
    "/agendamentos_telemedicina/{id}": {
      "schema": "object",
      "description": "Agenda de videoconsultas via Google Meet."
    },
    "/nursing_attendances/{id}": {
      "schema": "object",
      "description": "Registros de triagem e ambulatório operacional."
    },
    "/atendimentos_aso/{id}": {
      "schema": "object",
      "description": "Histórico de ASOs emitidos e assinados."
    },
    "/feedback/{id}": {
      "schema": "object",
      "description": "Avaliações de experiência da plataforma."
    }
  }
}
