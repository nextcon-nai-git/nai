rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Funções de Apoio Robustas (Híbridas: Token + Firestore Doc) ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Obtém dados do perfil em tempo real (cacheado pelo Firestore por requisição)
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.role in ['SUPER_ADMIN', 'ADMIN', 'ENGINEER'] || 
        profile().role in ['SUPER_ADMIN', 'ADMIN', 'ENGINEER']
      );
    }
    
    function isClientAdmin(companyId) { 
      return isSignedIn() && (
        (request.auth.token.role == 'CLIENT_ADMIN' && request.auth.token.companyId == companyId) ||
        (profile().role == 'CLIENT_ADMIN' && profile().companyId == companyId)
      );
    }
    
    function isDoctor() { 
      return isSignedIn() && (
        request.auth.token.role == 'DOCTOR' || 
        profile().role == 'DOCTOR'
      );
    }
    
    function isProvider() {
      return isSignedIn() && (
        request.auth.token.role == 'PROVIDER' || 
        profile().role == 'PROVIDER'
      );
    }

    // --- Regras por Coleção ---

    // Configurações Globais da NAI (Widget, Pitch de Vendas, etc)
    match /config_nai_avatar/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Empresas e Subcoleções (Isolamento Multi-tenant)
    match /companies/{companyId} {
      allow read: if isSignedIn(); 
      allow write: if isSuperAdmin() || isClientAdmin(companyId);
      
      match /{allSubcollections=**} {
        allow read: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
        allow write: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
      }
    }

    // Atendimentos ASO (Base Clínica)
    match /atendimentos_aso/{atendimentoId} {
      allow read: if isSuperAdmin() || isDoctor() || isClientAdmin(resource.data.companyId);
      allow create, update: if isSuperAdmin() || isDoctor();
      allow delete: if isSuperAdmin();
    }

    // Agendamentos (Fila de Espera)
    match /agendamentos/{agendamentoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Atendimentos de Enfermagem e Triagem
    match /nursing_attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isDoctor() || isProvider();
    }

    // Auditoria Médica e Regulação (Super-Junta)
    match /medical_audit_requests/{requestId} {
      allow read, write: if isSuperAdmin() || isDoctor();
    }

    // Telemedicina (Google Meet Links)
    match /agendamentos_telemedicina/{id} {
      allow read, write: if isSignedIn();
    }

    // Feedback da Plataforma
    match /feedback/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      
      // Bloqueia alteração de cargo/empresa por conta própria
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId
      );
    }

    // Suporte para Collection Group Queries (Buscas globais filtradas)
    match /{path=**}/employees/{empId} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(get(/databases/$(database)/documents/companies/$(path.split('/')[1])).data.id);
    }
    match /{path=**}/tasks/{taskId} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(get(/databases/$(database)/documents/companies/$(path.split('/')[1])).data.id);
    }
    match /{path=**}/legalExpertises/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(get(/databases/$(database)/documents/companies/$(path.split('/')[1])).data.id);
    }
    match /{path=**}/reports/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(get(/databases/$(database)/documents/companies/$(path.split('/')[1])).data.id);
    }
    match /{path=**}/contracts/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(get(/databases/$(database)/documents/companies/$(path.split('/')[1])).data.id);
    }
  }
}