rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Funções de Apoio Robustas (Híbridas: Token + Firestore Doc) ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Verificação de Email de Engenharia/Admin (Segurança de Bootstrap)
    function isSystemAdminEmail() {
      return request.auth.token.email in ['nextcon@nextconsaude.com.br', 'admin@nextcon.com.br', 'felipe.bianca@prestador.nai.com.br'];
    }

    // Obtém dados do perfil em tempo real (cacheado pelo Firestore por requisição)
    function profile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    
    function hasRole(roles) {
      let userRole = request.auth.token.role != null ? request.auth.token.role : (profile() != null ? profile().role : 'USER');
      return userRole in roles || isSystemAdminEmail();
    }

    function isSuperAdmin() { 
      return hasRole(['SUPER_ADMIN', 'ADMIN', 'ENGINEER']);
    }
    
    function isClientAdmin(companyId) { 
      let p = profile();
      return isSignedIn() && (
        (request.auth.token.role == 'CLIENT_ADMIN' && request.auth.token.companyId == companyId) ||
        (p != null && p.role == 'CLIENT_ADMIN' && p.companyId == companyId) ||
        isSuperAdmin()
      );
    }
    
    function isDoctor() { return hasRole(['DOCTOR', 'SUPER_ADMIN', 'ADMIN']); }
    function isProvider() { return hasRole(['PROVIDER', 'ENGINEER', 'SUPER_ADMIN', 'ADMIN']); }

    // --- Regras por Coleção ---

    // Configurações Globais da NAI (Widget, Pitch de Vendas, etc)
    match /config_nai_avatar/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Empresas e Subcoleções (Isolamento Multi-tenant)
    match /companies/{companyId} {
      allow read: if isSignedIn(); 
      allow write: if isSuperAdmin() || isClientAdmin(companyId);
      
      match /{allSubcollections=**} {
        allow read: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
        allow write: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
      }
    }

    // Atendimentos ASO (Base Clínica)
    match /atendimentos_aso/{atendimentoId} {
      allow read: if isSuperAdmin() || isDoctor() || isClientAdmin(resource.data.companyId);
      allow create, update: if isSuperAdmin() || isDoctor();
      allow delete: if isSuperAdmin();
    }

    // Agendamentos (Fila de Espera)
    match /agendamentos/{agendamentoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Atendimentos de Enfermagem e Triagem
    match /nursing_attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isDoctor() || isProvider();
    }

    // Auditoria Médica e Regulação (Super-Junta)
    match /medical_audit_requests/{requestId} {
      allow read, write: if isSuperAdmin() || isDoctor();
    }

    // Telemedicina (Google Meet Links)
    match /agendamentos_telemedicina/{id} {
      allow read, write: if isSignedIn();
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isSignedIn();
      // Permite que o usuário crie seu próprio perfil no login ou o Admin gerencie
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (request.auth.uid == userId);
    }

    // --- Suporte para Collection Group Queries (Buscas globais otimizadas) ---
    // Estrutura esperada: /companies/{cid}/subcolecao/{id}
    
    match /companies/{cid}/employees/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(cid);
    }
    match /companies/{cid}/tasks/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(cid);
    }
    match /companies/{cid}/legalExpertises/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(cid);
    }
    match /companies/{cid}/reports/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(cid);
    }
    match /companies/{cid}/contracts/{id} {
      allow read: if isSuperAdmin() || isDoctor() || isProvider() || isClientAdmin(cid);
    }
    match /companies/{cid}/esocial_events_queue/{id} {
      allow read: if isSuperAdmin() || isClientAdmin(cid);
    }
    match /companies/{cid}/access_logs/{id} {
      allow read: if isSuperAdmin() || isClientAdmin(cid);
    }
  }
}