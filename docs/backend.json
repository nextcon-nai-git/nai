
{
  "entities": {
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Cliente",
      "type": "object",
      "description": "Representa uma empresa cliente na plataforma NextCon SST.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único da empresa (UID do Firebase)."
        },
        "name": {
          "type": "string",
          "description": "Nome ou Razão Social da empresa."
        },
        "cnpj": {
          "type": "string",
          "description": "CNPJ da empresa cliente."
        },
        "address": {
          "type": "string",
          "description": "Endereço físico da empresa."
        },
        "contactEmail": {
          "type": "string",
          "description": "E-mail principal de contato.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "name",
        "cnpj"
      ]
    },
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Colaborador",
      "type": "object",
      "description": "Representa um funcionário dentro do sistema.",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único do funcionário."
        },
        "clientId": {
          "type": "string",
          "description": "ID do cliente (empresa) ao qual este funcionário pertence."
        },
        "name": {
          "type": "string",
          "description": "Nome completo do funcionário."
        },
        "jobRole": {
          "type": "string",
          "description": "Cargo ou função do funcionário."
        },
        "admissionDate": {
          "type": "string",
          "description": "Data de admissão.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "clientId",
        "name"
      ]
    },
    "MedicalExam": {
      "title": "Exame Médico",
      "type": "object",
      "description": "Registro de exames do PCMSO.",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "examType": { "type": "string" },
        "examDate": { "type": "string", "format": "date-time" },
        "result": { "type": "string" }
      },
      "required": ["id", "employeeId", "examType", "examDate", "result"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Dados mestres da empresa cliente."
    },
    "/clients/{clientId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Lista de colaboradores por empresa."
    },
    "/clients/{clientId}/employees/{employeeId}/medicalExams/{examId}": {
      "schema": "MedicalExam",
      "description": "Histórico de ASOs e exames complementares."
    }
  }
}
