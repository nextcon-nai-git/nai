
{
  "entities": {
    "Agency": {
      "title": "Agência Nextcon",
      "type": "object",
      "description": "Dados da agência de SST que gerencia múltiplos clientes.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ManagedCompany": {
      "title": "Empresa Cliente",
      "type": "object",
      "description": "Empresa atendida pela agência.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "sector": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Employee": {
      "title": "Colaborador",
      "type": "object",
      "description": "Funcionário de uma empresa cliente.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "jobRole": { "type": "string" },
        "admissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "title": "Fornecedor",
      "type": "object",
      "description": "Clínicas, laboratórios ou prestadores de serviço.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "serviceType": { "type": "string" },
        "cnpj": { "type": "string" },
        "city": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "MedicalExam": {
      "title": "Exame Médico",
      "type": "object",
      "description": "Registro de exames do PCMSO.",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "examType": { "type": "string" },
        "examDate": { "type": "string", "format": "date-time" },
        "result": { "type": "string" }
      },
      "required": ["id", "employeeId", "examType", "examDate", "result"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/clients/{agencyId}": {
      "schema": "Agency",
      "description": "Perfil da agência logada."
    },
    "/clients/{agencyId}/managedCompanies/{companyId}": {
      "schema": "ManagedCompany",
      "description": "Empresas clientes gerendiadas pela agência."
    },
    "/clients/{agencyId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Base global de colaboradores atendidos pela agência."
    },
    "/clients/{agencyId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Rede credenciada (clínicas e parceiros)."
    }
  }
}
