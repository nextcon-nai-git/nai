
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPrivileged() {
      return isSignedIn() && getUserRole() in ['SUPER_ADMIN', 'ENGINEER', 'DOCTOR'];
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // --- RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isPrivileged());
      allow write: if isPrivileged();
    }

    match /companies/{companyId} {
      allow read: if isPrivileged() || isCompanyMember(companyId);
      allow write: if isPrivileged();

      match /{allSubcollections=**} {
        allow read: if isPrivileged() || isCompanyMember(companyId);
        allow write: if isPrivileged();
      }
    }

    match /catalogs/{allCatalogs=**} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }
  }
}
