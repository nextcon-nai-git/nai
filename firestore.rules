
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio para RBAC e Geofencing
    function isAutenticado() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      return isAutenticado() && (data.role == 'SUPER_ADMIN' || data.role == 'ADMIN');
    }

    function isClientAdmin(companyId) {
      let data = getUserData();
      return isAutenticado() && data.role == 'CLIENT_ADMIN' && data.companyId == companyId;
    }

    function isServedProvider(companyId) {
      let data = getUserData();
      let role = data.role;
      return isAutenticado() && 
             (role == 'PROVIDER' || role == 'ENGINEER' || role == 'DOCTOR') && 
             (data.servedCompanies != null && companyId in data.servedCompanies);
    }

    // Regras para Medicina do Trabalho
    
    match /empresas/{empresaId} {
      allow read: if isAdmin() || isClientAdmin(empresaId) || isServedProvider(empresaId);
      allow write: if isAdmin();
    }

    match /colaboradores/{colaboradorId} {
      allow read: if isAdmin() || isClientAdmin(resource.data.empresa_id) || isServedProvider(resource.data.empresa_id);
      allow write: if isAdmin() || isClientAdmin(request.resource.data.empresa_id);
    }

    match /agendamentos/{agendamentoId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || isClientAdmin(request.resource.data.empresa_id) || isServedProvider(request.resource.data.empresa_id);
    }

    match /atendimentos_aso/{atendimentoId} {
      allow read: if isAdmin() || isClientAdmin(resource.data.empresa_id) || isServedProvider(resource.data.empresa_id);
      allow write: if isAdmin() || isServedProvider(request.resource.data.empresa_id);
    }

    match /clinicas_parceiras/{clinicaId} {
      allow read: if isAutenticado();
      allow write: if isAdmin();
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Fallback Administrativo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
