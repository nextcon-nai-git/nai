
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Funções de Apoio Robustas ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSystemAdminEmail() {
      return request.auth.token.email in ['nextcon@nextconsaude.com.br', 'admin@nextcon.com.br', 'felipe.bianca@prestador.nai.com.br'];
    }

    function profile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    
    function hasRole(roles) {
      let userRole = request.auth.token.role != null ? request.auth.token.role : (profile() != null ? profile().role : 'USER');
      return userRole in roles || isSystemAdminEmail();
    }

    function isSuperAdmin() { 
      return hasRole(['SUPER_ADMIN', 'ADMIN', 'ENGINEER']);
    }
    
    function isClientAdmin(companyId) { 
      let p = profile();
      return isSignedIn() && (
        (request.auth.token.role == 'CLIENT_ADMIN' && request.auth.token.companyId == companyId) ||
        (p != null && p.role == 'CLIENT_ADMIN' && p.companyId == companyId) ||
        isSuperAdmin()
      );
    }
    
    function isDoctor() { return hasRole(['DOCTOR', 'SUPER_ADMIN', 'ADMIN']); }
    function isProvider() { return hasRole(['PROVIDER', 'ENGINEER', 'SUPER_ADMIN', 'ADMIN']); }

    // --- Coleções de Atendimento Clínico ---
    match /agendamentos/{id} {
      allow read: if isSignedIn();
      allow write: if isDoctor() || isSuperAdmin();
    }

    match /agendamentos_telemedicina/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isDoctor() || isSuperAdmin();
    }

    match /nursing_attendances/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /atendimentos_aso/{atendimentoId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isDoctor() || isClientAdmin(resource.data.companyId));
      allow create, update: if isSuperAdmin() || isDoctor();
      allow delete: if isSuperAdmin();
    }

    match /orcamentos/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /feedback/{id} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
    }

    match /meetings/{meetingId} {
      function isMeetingParticipant() {
        let meeting = resource.data;
        return request.auth.uid == meeting.doctorId || request.auth.uid == meeting.patientId;
      }
      allow read, update: if isSignedIn() && (isMeetingParticipant() || isSuperAdmin());
      allow create: if isSignedIn() && isDoctor();
      match /signaling/{participantId} { allow read, write: if isSignedIn(); }
      match /telemetry/{timestamp} { allow read, write: if isSignedIn(); }
    }

    // --- Empresas e Subcoleções ---
    match /companies/{companyId} {
      allow read: if isSignedIn(); 
      allow write: if isSuperAdmin() || isClientAdmin(companyId);
      match /{allSubcollections=**} {
        allow read: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
        allow write: if isSuperAdmin() || isClientAdmin(companyId) || isDoctor() || isProvider();
      }
    }

    match /config_nai_avatar/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- Usuários (Proteção de Perfil) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId 
        && request.resource.data.role == resource.data.role 
        && request.resource.data.companyId == resource.data.companyId
      );
    }
  }
}
