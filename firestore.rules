rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isSuperAdmin() {
      let userData = getUserData();
      let role = userData.get('role', '').upper();
      let companyId = userData.get('companyId', '');
      return isAuth() && 
        (role == 'SUPER_ADMIN' || role == 'ENGINEER' || role == 'DOCTOR' || role == 'ADMIN') &&
        (companyId == null || companyId == "");
    }

    function isUserInCompany(companyId) {
      let userData = getUserData();
      let userCompanyId = userData.get('companyId', '');
      return isAuth() && (userCompanyId == companyId || isSuperAdmin());
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin() || (isAuth() && request.auth.uid == userId);
    }

    match /companies/{companyId} {
      allow read: if isUserInCompany(companyId);
      allow update: if isSuperAdmin() || (isUserInCompany(companyId) && getUserData().get('role', '') == 'CLIENT_ADMIN');
      allow create, delete: if isSuperAdmin();

      match /{document=**} {
        allow read, write: if isUserInCompany(companyId);
      }
    }

    match /orcamentos/{allPaths=**} {
      allow read, write: if true;
    }

    match /catalogs/{catalogId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isAuth();
      allow read, update, delete: if isSuperAdmin();
    }

    match /financialStats/{docId} {
      allow read, write: if isSuperAdmin();
    }
  }
}