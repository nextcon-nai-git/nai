rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: permite leitura/escrita para qualquer usuário autenticado.
    // Essencial para o isolamento multi-tenant básico durante o desenvolvimento.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regras explícitas para Collection Groups.
    // O Firestore exige matches específicos com curinga de caminho ({path=**}) 
    // para autorizar consultas globais via collectionGroup (utilizadas nos Dashboards).
    
    match /{path=**}/tasks/{task} {
      allow read: if request.auth != null;
    }
    match /{path=**}/employees/{employee} {
      allow read: if request.auth != null;
    }
    match /{path=**}/reports/{report} {
      allow read: if request.auth != null;
    }
    match /{path=**}/examHistory/{exam} {
      allow read: if request.auth != null;
    }
    match /{path=**}/auditHistory/{audit} {
      allow read: if request.auth != null;
    }
    match /{path=**}/legalExpertises/{expertise} {
      allow read: if request.auth != null;
    }
    match /{path=**}/sst_events/{event} {
      allow read: if request.auth != null;
    }

    // Catálogos públicos (Riscos eSocial, Tabela de Exames, etc)
    match /catalogs/{document=**} {
      allow read: if true;
    }
  }
}