
{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "**", "run": { "serviceId": "YOUR_FUNCTION_NAME" }}
    ]
  },
  "functions": {
    "source": "functions"
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
