
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : 'GUEST';
    }

    function isPrivileged() {
      let role = getUserRole();
      return isSignedIn() && (role in ['SUPER_ADMIN', 'ENGINEER', 'DOCTOR', 'admin']);
    }

    function isCompanyMember(companyId) {
      let data = getUserData();
      return isSignedIn() && data != null && data.companyId == companyId;
    }

    // --- COLLECTION GROUP RULES ---
    // Necessário para consultas globais dos Dashboards Administrativos
    match /{path=**}/employees/{id} { allow read: if isPrivileged(); }
    match /{path=**}/tasks/{id} { allow read: if isPrivileged(); }
    match /{path=**}/reports/{id} { allow read: if isPrivileged(); }
    match /{path=**}/auditHistory/{id} { allow read: if isPrivileged(); }
    match /{path=**}/examHistory/{id} { allow read: if isPrivileged(); }
    match /{path=**}/legalExpertises/{id} { allow read: if isPrivileged(); }
    match /{path=**}/sst_events/{id} { allow read: if isPrivileged(); }

    // --- STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isPrivileged());
      allow write: if isSignedIn() && (request.auth.uid == userId || isPrivileged());
    }

    match /companies/{companyId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (isPrivileged() || isCompanyMember(companyId));
      allow write: if isPrivileged();

      // Sub-coleções operacionais (Multi-tenancy)
      match /{allSubcollections=**} {
        allow read: if isPrivileged() || isCompanyMember(companyId);
        allow write: if isPrivileged();
      }
    }

    match /catalogs/{allCatalogs=**} {
      allow read: if isSignedIn();
      allow write: if isPrivileged();
    }
  }
}
