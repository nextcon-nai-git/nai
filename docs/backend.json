
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLIENT_ADMIN", "ENGINEER", "DOCTOR", "PROVIDER"] },
        "email": { "type": "string" },
        "companyId": { "type": "string", "description": "ID da empresa caso o usuário seja CLIENT_ADMIN" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "segment": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "risk_degree": { "type": "number" },
        "cnae": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "ProfessionalNorm": {
      "title": "ProfessionalNorm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoria": { "type": "string" },
        "orgao": { "type": "string" },
        "norma_principal": { "type": "string" },
        "foco_defesa": { "type": "string" },
        "gatilhos": { "type": "array", "items": { "type": "string" } },
        "texto_legal_padrao": { "type": "string" }
      }
    },
    "Jurisprudence": {
      "title": "Jurisprudence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "aplicacao": { "type": "string" },
        "argumento_automatico": { "type": "string" },
        "anexar_em": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ReverseDenialRule": {
      "title": "ReverseDenialRule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "descricao": { "type": "string" },
        "logica": { "type": "string" }
      }
    },
    "EmailRoutine": {
      "title": "EmailRoutine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "customEmail": { "type": "string" },
        "active": { "type": "boolean" },
        "companyId": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Employee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "job_role": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "cbo": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["active", "leave", "fired"] }
      }
    },
    "Training": {
      "title": "Training",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyId": { "type": "string" },
        "nrs": { "type": "array", "items": { "type": "string" } },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "totalHours": { "type": "number" },
        "modality": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "in_progress", "completed"] },
        "students": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Task": {
      "title": "OpsTask",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "priority": { "type": "string" },
        "ai_risk_score": { "type": "number" }
      }
    },
    "PlatformFeedback": {
      "title": "PlatformFeedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "suggestion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rating"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Perfis de acesso e permissões RBAC."
    },
    "/companies/{companyId}": {
      "schema": "#/entities/Company",
      "description": "Empresas clientes (Raiz)."
    },
    "/config_normas_profissionais/{normId}": {
      "schema": "#/entities/ProfessionalNorm",
      "description": "Base de inteligência dos conselhos profissionais."
    },
    "/config_jurisprudencia/{jurId}": {
      "schema": "#/entities/Jurisprudence",
      "description": "Repositório de teses jurídicas e decisões STJ/ANS."
    },
    "/config_glosa_reversa/{ruleId}": {
      "schema": "#/entities/ReverseDenialRule",
      "description": "Regras automáticas para validação de contas hospitalares."
    },
    "/companies/{companyId}/settings/emailRoutine": {
      "schema": "#/entities/EmailRoutine",
      "description": "Configurações de envio automático de relatórios NAI."
    },
    "/companies/{companyId}/employees/{employeeId}": {
      "schema": "#/entities/Employee",
      "description": "Funcionários isolados por empresa."
    },
    "/companies/{companyId}/tasks/{taskId}": {
      "schema": "#/entities/Task",
      "description": "Cards de operação (Kanban) da empresa."
    },
    "/companies/{companyId}/trainings/{trainingId}": {
      "schema": "#/entities/Training",
      "description": "Treinamentos de NRs vinculados à empresa."
    },
    "/feedback/{feedbackId}": {
      "schema": "#/entities/PlatformFeedback",
      "description": "Avaliações e sugestões enviadas pelos usuários."
    }
  }
}
