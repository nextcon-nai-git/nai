rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    function isNextconOfficial() { return request.auth.token.email == 'nextcon@nextconsaude.com.br'; }
    
    function profile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    match /config_nai_avatar/{docId} {
      allow read: if isSignedIn();
      allow write: if isNextconOfficial();
    }

    match /relatorios_sst/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isNextconOfficial();
    }

    match /analisesPGR/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isNextconOfficial();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isNextconOfficial();
      match /{allSubcollections=**} {
        allow read, write: if isNextconOfficial() || (isSignedIn() && profile().companyId == companyId);
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isNextconOfficial());
    }
    
    match /{allSubcollections=**} {
      allow read: if isSignedIn();
      allow write: if isNextconOfficial();
    }
  }
}
